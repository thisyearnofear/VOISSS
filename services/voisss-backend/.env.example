# ElevenLabs API Configuration
ELEVENLABS_API_KEY=[redacted]

# Server Configuration
PORT=5577
NODE_ENV=production

# API Authentication (comma-separated list of API keys)
# Format: "key1,key2" or named "web:key1,agent:key2"
# REQUIRED in production — if unset, all protected routes reject requests.
# Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=[redacted]

# Server-side key the Next.js web app uses to call protected backend routes.
# Must match one of the entries in API_KEYS above. Set on the web app side as
# VOISSS_BACKEND_API_KEY.

# Local dev only: bypass API_KEYS requirement (NEVER set in production)
# ALLOW_UNAUTHENTICATED_DEV=true

# Logging
LOG_LEVEL=info

# Blockchain Configuration (for gasless transactions)
SPENDER_PRIVATE_KEY=[redacted]
BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_VOICE_RECORDS_CONTRACT=your_contract_address_here
NEXT_PUBLIC_SPENDER_ADDRESS=your_spender_public_address_here

# Database Configuration (PostgreSQL)
# Auto-configured via docker-compose: postgres:5432 for production
# For local dev: connect to remote server at your-server-ip:5432
DATABASE_URL=[redacted]
DB_PASSWORD=[redacted]
DB_POOL_MAX=10

# Export Service Configuration
EXPORT_TEMP_DIR=/tmp/voisss-exports
EXPORT_OUTPUT_DIR=/var/www/voisss-exports
EXPORT_PUBLIC_URL=http://localhost:5577

# SSRF guard: comma-separated extra hosts allowed for export downloads
# (defaults already include api.elevenlabs.io, storage.googleapis.com, ipfs.io)
# EXPORT_ALLOWED_HOSTS=cdn.example.com,*.example.com
# EXPORT_MAX_DOWNLOAD_BYTES=104857600
# EXPORT_MAX_ATTEMPTS=3

# Worker Configuration
WORKER_INSTANCES=2
WORKER_CONCURRENCY=2

# Optional: Override default model
# ELEVENLABS_MODEL_ID=eleven_multilingual_sts_v2

# CORS allowlist (comma-separated). Production should only list https origins.
# (voisss.app is not deployed — don't add it unless DNS is live)
CORS_ORIGINS=https://voisss.netlify.app

# Base Configuration (Layer 2)
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# AI Integrations (Google Gemini / Venice fallback)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_AUDIO_MODEL=gemini-3.1-pro-preview
# GOOGLE_API_KEY= (Alternative)
VENICE_API_KEY=
VENICE_API_URL=https://api.venice.ai/api/v1
VENICE_MODEL=llama-3.3-70b

# Optional: TypeSafe Jev — intent matching on the marketplace (~100ms decisions)
# Free path: Vercel AI Gateway (experimental_evaluate, model typesafe-ai/jev)
AI_GATEWAY_API_KEY=
# Direct path (used when AI_GATEWAY_API_KEY is unset):
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# AI Integrations (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ── GTM / Analytics ──────────────────────────────────────────────
# GA4 Measurement ID (e.g. G-XXXXXXXXXX). When set, layout.tsx loads
# gtag + /api/analytics/funnel forwards conversion events to GA4.
# Get one free at https://analytics.google.com → Admin → Data Streams.
NEXT_PUBLIC_GA_ID=
# Server-side Measurement Protocol secret (GA Admin → Data Streams → Measurement
# Protocol API secrets). Required together with NEXT_PUBLIC_GA_ID — without it
# /api/analytics/funnel accepts events but forwards nothing to GA4.
GA_API_SECRET=
# Canonical production URL used for sitemap/robots/OG + Stripe success URLs.
NEXT_PUBLIC_BASE_URL=https://voisss.netlify.app

# On-Chain Contracts
NEXT_PUBLIC_VOISSS_CONTRACT_ADDRESS=
NEXT_PUBLIC_VOICE_LICENSE_MARKET_ADDRESS=
NEXT_PUBLIC_VOICE_RECORDS_CONTRACT=
ENVIO_INDEXER_URL=

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_JWT=

# ── Lead capture (contact + newsletter) ─────────────────────────────
# Resend key for support notifications + newsletter confirmation.
RESEND_API_KEY=
# Where contact-form notifications land.
SUPPORT_EMAIL=
# Verified sender identity in Resend (must be a domain you own).
NEWSLETTER_FROM=
